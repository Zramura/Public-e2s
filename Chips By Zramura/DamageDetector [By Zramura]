# _DMG_M9K_TEMP_NAME is a temp name until a better / correct one is found # alternative TypeTable By Zramura
const TypeTable = table(0 = "_DMG_GENERIC",1 = "_DMG_CRUSH",2 = "_DMG_BULLET",4 = "_DMG_SLASH",8 = "_DMG_BURN",16 = "_DMG_VEHICLE",32 = "_DMG_FALL",64 = "_DMG_BLAST",128 = "_DMG_CLUB",256 = "_DMG_SHOCK",512 = "_DMG_SONIC",1024 = "_DMG_ENERGYBEAM",2048 = "_DMG_PREVENT_PHYSICS_FORCE",4096 = "_DMG_NEVERGIB",8192 = "_DMG_ALWAYSGIB",8194 = "_DMG_M9K_TEMP_NAME",16384 = "_DMG_DROWN",32768 = "_DMG_PARALYZE",65536 = "_DMG_NERVEGAS",131072 = "_DMG_POISON",262144 = "_DMG_RADIATION",524288 = "_DMG_DROWNRECOVER",1048576 = "_DMG_ACID",2097152 = "_DMG_SLOWBURN",4194304 = "_DMG_REMOVENORAGDOLL",8388608 = "_DMG_PHYSGUN",16777216 = "_DMG_PLASMA",33554432 = "_DMG_AIRBOAT",67108864 = "_DMG_DISSOLVE",268435456 = "_DMG_DIRECT",536870912 = _DMG_BUCKSHOT,134217728 = _DMG_BLAST_SURFACE,1073741824 = "_DMG_SNIPER",2147483648 = "_DMG_MISSILEDEFENSE")

# Function made by The808Error and reNamed by Zramura
function get_Damage_Type(Damage:damage){
    return TypeTable[Damage:getDamageType(),string]
}

Count = Damage = 0
DamageType = ""
Entity = entity():isWeldedTo()

if(!Entity:isValid()){
    error("place the chip on a valid entity: " + Entity:toString())
}

event entityDamage(Victim:entity, DMG:damage){
    if(Victim != Entity){exit()}
    Damage = round(DMG:getAmount(),2)
    Count += Damage
    DamageType = get_Damage_Type(DMG)
#    hint("Damage Type " + DamageType + " :: Amount = " + Damage:toString() + " :: total = "+Count:toString(), 0.5) # uncomment to print to hud
#    print("Damage Type " + DamageType + " :: Amount = " + Damage:toString() + " :: total = "+Count:toString())     # uncomment to print to chat
}

event input(InputName:string){
    if(InputName == "Reset_Button" & Reset_Button){
        Count = Damage = 0
    }
}
